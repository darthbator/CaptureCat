# Optional overrides for local development (`pnpm dev` works without any of these).
# Real OAuth on localhost: create separate DEV OAuth apps with callback
#   http://localhost:5173/api/auth/callback/<provider>
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# MOCK_OIDC_DISCOVERY_URL=http://localhost:8080/default/.well-known/openid-configuration
