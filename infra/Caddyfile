# Production entry point: HTTPS (automatic Let's Encrypt for $DOMAIN), the SPA, and the API.
# The API itself enforces auth on /api, /media and /live.
{
	# Clients send no SNI when connecting to a bare IP (e.g. DOMAIN=192.168.x.x on a LAN);
	# without this Caddy aborts the TLS handshake.
	default_sni {$DOMAIN}
}

{$DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	@backend path /api/* /media/* /live/*
	handle @backend {
		# flush_interval -1: stream SSE and LL-HLS responses immediately.
		reverse_proxy api:4000 {
			flush_interval -1
		}
	}

	handle {
		encode zstd gzip
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
