# Production entry point: HTTPS, the SPA, and the API.
# The API itself enforces auth on /api, /media and /live.
#
# CADDY_MODE picks how the site is served (set in infra/.env):
#   public (default)  DOMAIN is a real hostname → Let's Encrypt certificate
#   lan               DOMAIN is a LAN IP/hostname → Caddy's own CA (browser warning).
#                     Browsers send no SNI for IP addresses, so lan mode adds a catch-all
#                     https:// address; without it the TLS handshake is aborted.
{
	default_sni {$DOMAIN}
}

(app) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	@backend path /api/* /media/* /live/*
	handle @backend {
		# flush_interval -1: stream SSE and LL-HLS responses immediately.
		reverse_proxy api:4000 {
			flush_interval -1
		}
	}

	handle {
		encode zstd gzip
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}

import /etc/caddy/sites-{$CADDY_MODE:public}.caddy
