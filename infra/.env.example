# Copy to infra/.env and fill in. Never commit the real file.
DOMAIN=capturecat.example.com
# public = real domain (Let's Encrypt). lan = LAN IP or local hostname (self-signed, browser warning).
CADDY_MODE=public
# Hostname shown to streamers for RTMP/SRT (defaults to DOMAIN).
INGEST_HOST=

# Generate each with: openssl rand -base64 36
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
MEDIAMTX_SECRET=

# Storage
# Host folder for all video data. Must exist and be owned by uid 1000:
#   sudo mkdir -p /srv/capturecat/media && sudo chown 1000:1000 /srv/capturecat/media
MEDIA_DIR=/srv/capturecat/media
DEFAULT_QUOTA_GB=20
MIN_FREE_DISK_GB=5

# OAuth apps: callback URL is https://<DOMAIN>/api/auth/callback/<provider>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
