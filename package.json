{
  "name": "capture-cat",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "db:generate": "pnpm --filter @capturecat/db generate",
    "seed": "pnpm --filter @capturecat/api seed",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "test:smoke": "pnpm --filter @capturecat/api smoke",
    "test:e2e": "pnpm --filter @capturecat/web e2e",
    "build": "pnpm --filter @capturecat/web build"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "typescript": "^7.0.2",
    "@types/node": "^26.6.11"
  }
}
